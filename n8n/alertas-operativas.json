      "id": "0a1b2c3d-0001-4000-8000-000000000002",
      "name": "Consultar jobs fallidos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Deduplica jobs fallidos por jobId usando el estado del propio workflow en n8n.\n// n8n solo notifica: no escribe estados de pago/orden ni toca PostgreSQL.\nconst store = $getWorkflowStaticData('global');\nconst seen = store.seenFailedJobIds ?? {};\nconst now = Date.now();\nconst RETENTION_MS = 7 * 24 * 60 * 60 * 1000;\n\nconst fallidos = items.filter(\n  (item) => item.json && item.json.status === 'failed' && item.json.jobId,\n);\nconst nuevos = fallidos.filter(\n  (item) => !Object.prototype.hasOwnProperty.call(seen, item.json.jobId),\n);\n\nfor (const item of nuevos) seen[item.json.jobId] = now;\nfor (const [jobId, timestamp] of Object.entries(seen)) {\n  if (typeof timestamp !== 'number' || now - timestamp > RETENTION_MS) delete seen[jobId];\n}\nstore.seenFailedJobIds = seen;\n\n// Sin jobs nuevos no se emite ningun item: los nodos siguientes no se ejecutan.\nif (nuevos.length === 0) return [];\n\nreturn [\n  {\n    json: {\n      tipo: 'jobs_fallidos',\n      businessId: $env.BUSINESS_ID || null,\n      detectadoEn: new Date().toISOString(),\n      total: nuevos.length,\n      jobs: nuevos.map((item) => ({\n        jobId: item.json.jobId,\n        jobType: item.json.jobType || null,\n        status: item.json.status,\n        attempts: item.json.attempts ?? null,\n        maxAttempts: item.json.maxAttempts ?? null,\n        lastError: item.json.lastError || null,\n        updatedAt: item.json.updatedAt || null,\n      })),\n    },\n  },\n];"
      },
      "id": "0a1b2c3d-0001-4000-8000-000000000003",
      "name": "Deduplicar jobs fallidos",
