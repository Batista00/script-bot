            "version": 2
          },
          "conditions": [
            {
              "id": "0a1b2c3d-0003-4000-8000-000000000012",
              "leftValue": "={{ $env.ALERT_WEBHOOK_URL }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0a1b2c3d-0003-4000-8000-000000000008",
      "name": "ALERT_WEBHOOK_URL configurado",
