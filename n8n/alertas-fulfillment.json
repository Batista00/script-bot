      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Deduplica fulfillments por id usando el estado del propio workflow en n8n.\n// Requiere revision humana en el panel: n8n no reenvia pedidos ni cambia estados.\nconst store = $getWorkflowStaticData('global');\nconst seen = store.seenSubmissionUnknownIds ?? {};\nconst now = Date.now();\nconst RETENTION_MS = 7 * 24 * 60 * 60 * 1000;\n\nconst inciertos = items.filter(\n  (item) => item.json && item.json.status === 'submission_unknown' && item.json.id,\n);\nconst nuevos = inciertos.filter(\n  (item) => !Object.prototype.hasOwnProperty.call(seen, item.json.id),\n);\n\nfor (const item of nuevos) seen[item.json.id] = now;\nfor (const [id, timestamp] of Object.entries(seen)) {\n  if (typeof timestamp !== 'number' || now - timestamp > RETENTION_MS) delete seen[id];\n}\nstore.seenSubmissionUnknownIds = seen;\n\n// Sin novedades no se emite ningun item y los nodos siguientes no se ejecutan.\nif (nuevos.length === 0) return [];\n\nreturn [\n  {\n    json: {\n      tipo: 'fulfillment_submission_unknown',\n      businessId: $env.BUSINESS_ID || null,\n      detectadoEn: new Date().toISOString(),\n      total: nuevos.length,\n      requireRevisionManual: true,\n      fulfillments: nuevos.map((item) => ({\n        fulfillmentId: item.json.id,\n        orderId: item.json.orderId || null,\n        orderItemId: item.json.orderItemId || null,\n        providerKey: item.json.providerKey || null,\n        status: item.json.status,\n        providerOrderId: item.json.providerOrderId || null,\n        submissionAttemptedAt: item.json.submissionAttemptedAt || null,\n        updatedAt: item.json.updatedAt || null,\n      })),\n    },\n  },\n];"
      },
