      "id": "0a1b2c3d-0002-4000-8000-000000000004",
      "name": "Unir respuestas",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [0, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Solo agrega lo que ya devolvio el backend: n8n no recalcula precios ni estados.\nconst pedidos = $('Consultar pedidos recientes').all().map((item) => item.json);\nconst pagos = $('Consultar pagos recientes').all().map((item) => item.json);\n\nconst contarPorEstado = (coleccion) => {\n  const conteo = {};\n  for (const registro of coleccion) {\n    const estado = registro && registro.status ? registro.status : 'desconocido';\n    conteo[estado] = (conteo[estado] ?? 0) + 1;\n  }\n  return conteo;\n};\n\nconst hoy = new Date().toISOString().slice(0, 10);\nconst aprobadosHoy = pagos.filter(\n  (pago) =>\n    pago &&\n    pago.status === 'approved' &&\n    typeof pago.approvedAt === 'string' &&\n    pago.approvedAt.slice(0, 10) === hoy,\n);\n\nconst totalesPorMoneda = {};\nfor (const pago of aprobadosHoy) {\n  const moneda = pago.currency || 'desconocida';\n  totalesPorMoneda[moneda] = (totalesPorMoneda[moneda] ?? 0) + Number(pago.amount ?? 0);\n}\nfor (const moneda of Object.keys(totalesPorMoneda)) {\n  totalesPorMoneda[moneda] = Number(totalesPorMoneda[moneda].toFixed(2));\n}\n\nreturn [\n  {\n    json: {\n      tipo: 'reporte_diario',\n      businessId: $env.BUSINESS_ID || null,\n      generadoEn: new Date().toISOString(),\n      fecha: hoy,\n      pedidos: { total: pedidos.length, porEstado: contarPorEstado(pedidos) },\n      pagos: { total: pagos.length, porEstado: contarPorEstado(pagos) },\n      cobradoHoy: {\n        pagosAprobados: aprobadosHoy.length,\n        totalesPorMoneda,\n      },\n    },\n  },\n];"
      },
