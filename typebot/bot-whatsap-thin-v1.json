      "variableId": "vturn",
      "labels": {
       "placeholder": "Escribe tu mensaje"
      }
     }
    },
    {
     "id": "blkrouterwebhook",
     "type": "Webhook",
     "options": {
      "webhook": {
       "url": "{{backend_base_url}}/bot/v1/conversation/turn",
       "method": "POST",
       "headers": [
        {
         "id": "hdrrouter",
         "key": "Authorization",
         "value": "Bearer {{backend_token}}"
        },
        {
         "id": "hdrrouterct",
         "key": "Content-Type",
         "value": "application/json"
        }
       ],
       "body": "{\n  \"remoteJid\": \"{{remoteJid}}\",\n  \"text\": \"{{turn}}\"\n}"
