{
  "version": "6.1",
  "id": "cmtypebotcommercev10000001",
  "name": "BOT WHATSAP - Commerce v1",
  "events": [
    {
      "id": "evtcommercev1start",
      "outgoingEdgeId": "edgestartentry",
      "graphCoordinates": { "x": 0, "y": 0 },
      "type": "start"
    }
  ],
  "groups": [
    {
      "id": "grpentrycontext",
      "title": "Origen de la conversación",
      "graphCoordinates": { "x": 300, "y": 0 },
      "blocks": [
        {
          "id": "blkentrycondition",
          "type": "Condition",
          "items": [
            {
              "id": "itmentryviewer",
              "outgoingEdgeId": "edgeentryviewer",
              "content": {
                "comparisons": [
                  {
                    "id": "cmpremotejidempty",
                    "variableId": "vremotejid",
                    "comparisonOperator": "Equal to",
                    "value": ""
                  }
                ]
              }
            }
          ],
          "outgoingEdgeId": "edgeentryevolution"
        }
      ]
    },
    {
      "id": "grpvieweridentity",
      "title": "Fallback Viewer",
      "graphCoordinates": { "x": 680, "y": -220 },
      "blocks": [
        {
          "id": "blkviewernamequestion",
          "type": "text",
          "content": { "richText": [{ "id": "rtviewername", "type": "p", "children": [{ "text": "¿Cómo te llamas?" }] }] }
        },
        {
          "id": "blkviewernameinput",
          "type": "text input",
          "options": { "labels": { "placeholder": "Escribe tu nombre" }, "variableId": "vpushname" }
        },
        {
          "id": "blkviewerphonequestion",
          "type": "text",
          "content": { "richText": [{ "id": "rtviewerphone", "type": "p", "children": [{ "text": "¿Cuál es tu número de teléfono con código de país?" }] }] }
        },
        {
          "id": "blkviewerphoneinput",
          "type": "text input",
          "options": { "labels": { "placeholder": "Ejemplo: 56912345678" }, "variableId": "vwhatsappnumber" },
          "outgoingEdgeId": "edgeviewercustomer"
        }
      ]
    },
    {
      "id": "grpnormalizeevolution",
      "title": "Normalizar número Evolution",
      "graphCoordinates": { "x": 680, "y": 120 },
      "blocks": [
        {
          "id": "blknormalizephone",
          "type": "Set variable",
          "options": {
            "variableId": "vwhatsappnumber",
            "expressionToEvaluate": "{{remoteJid}}.split(\"@\")[0].split(\":\")[0]"
          },
          "outgoingEdgeId": "edgeevolutioncustomer"
        }
      ]
    },
    {
      "id": "grpcustomerresolve",
      "title": "Customer Resolve",
      "graphCoordinates": { "x": 1060, "y": 0 },
      "blocks": [
        {
          "id": "blkclearcustomerid",
          "type": "Set variable",
          "options": { "variableId": "vcustomerid", "expressionToEvaluate": "" }
        },
        {
          "id": "blkcustomerwebhook",
          "type": "Webhook",
          "options": {
            "webhook": {
              "url": "{{backend_base_url}}/bot/v1/customers/resolve",
              "method": "POST",
              "headers": [
                { "id": "hdrauthcustomer", "key": "Authorization", "value": "Bearer {{backend_token}}" },
                { "id": "hdrctcustomer", "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"name\": \"{{pushName}}\",\n  \"phone\": \"{{whatsappNumber}}\"\n}"
            },
            "isCustomBody": true,
            "responseVariableMapping": [
              { "id": "mapcustomerid", "bodyPath": "data.customerId", "variableId": "vcustomerid" },
              { "id": "mapcustomername", "bodyPath": "data.name", "variableId": "vcustomername" }
            ]
          }
        },
        {
          "id": "blkcustomercheck",
          "type": "Condition",
          "items": [
            {
              "id": "itmcustomermissing",
              "outgoingEdgeId": "edgecustomererror",
              "content": { "comparisons": [{ "id": "cmpcustomerempty", "variableId": "vcustomerid", "comparisonOperator": "Equal to", "value": "" }] }
            }
          ],
          "outgoingEdgeId": "edgecustomerproducts"
        }
      ]
    },
    {
      "id": "grpproductsfetch",
      "title": "Catálogo comercial",
      "graphCoordinates": { "x": 1440, "y": 0 },
      "blocks": [
        { "id": "blkclearproduct1", "type": "Set variable", "options": { "variableId": "vproduct1id", "expressionToEvaluate": "" } },
        { "id": "blkclearproduct2", "type": "Set variable", "options": { "variableId": "vproduct2id", "expressionToEvaluate": "" } },
        { "id": "blkclearproduct3", "type": "Set variable", "options": { "variableId": "vproduct3id", "expressionToEvaluate": "" } },
        { "id": "blkclearproduct4", "type": "Set variable", "options": { "variableId": "vproduct4id", "expressionToEvaluate": "" } },
        { "id": "blkclearproduct5", "type": "Set variable", "options": { "variableId": "vproduct5id", "expressionToEvaluate": "" } },
        {
          "id": "blkproductswebhook",
          "type": "Webhook",
          "options": {
            "webhook": {
              "url": "{{backend_base_url}}/bot/v1/products?limit=5&offset=0&type=service",
              "method": "GET",
              "headers": [
                { "id": "hdrauthproducts", "key": "Authorization", "value": "Bearer {{backend_token}}" }
              ]
            },
            "responseVariableMapping": [
              { "id": "mapproduct1id", "bodyPath": "data.0.productId", "variableId": "vproduct1id" },
              { "id": "mapproduct1name", "bodyPath": "data.0.name", "variableId": "vproduct1name" },
              { "id": "mapproduct1min", "bodyPath": "data.0.minQuantity", "variableId": "vproduct1min" },
              { "id": "mapproduct1max", "bodyPath": "data.0.maxQuantity", "variableId": "vproduct1max" },
              { "id": "mapproduct2id", "bodyPath": "data.1.productId", "variableId": "vproduct2id" },
              { "id": "mapproduct2name", "bodyPath": "data.1.name", "variableId": "vproduct2name" },
              { "id": "mapproduct2min", "bodyPath": "data.1.minQuantity", "variableId": "vproduct2min" },
              { "id": "mapproduct2max", "bodyPath": "data.1.maxQuantity", "variableId": "vproduct2max" },
              { "id": "mapproduct3id", "bodyPath": "data.2.productId", "variableId": "vproduct3id" },
              { "id": "mapproduct3name", "bodyPath": "data.2.name", "variableId": "vproduct3name" },
              { "id": "mapproduct3min", "bodyPath": "data.2.minQuantity", "variableId": "vproduct3min" },
              { "id": "mapproduct3max", "bodyPath": "data.2.maxQuantity", "variableId": "vproduct3max" },
              { "id": "mapproduct4id", "bodyPath": "data.3.productId", "variableId": "vproduct4id" },
              { "id": "mapproduct4name", "bodyPath": "data.3.name", "variableId": "vproduct4name" },
              { "id": "mapproduct4min", "bodyPath": "data.3.minQuantity", "variableId": "vproduct4min" },
              { "id": "mapproduct4max", "bodyPath": "data.3.maxQuantity", "variableId": "vproduct4max" },
              { "id": "mapproduct5id", "bodyPath": "data.4.productId", "variableId": "vproduct5id" },
              { "id": "mapproduct5name", "bodyPath": "data.4.name", "variableId": "vproduct5name" },
              { "id": "mapproduct5min", "bodyPath": "data.4.minQuantity", "variableId": "vproduct5min" },
              { "id": "mapproduct5max", "bodyPath": "data.4.maxQuantity", "variableId": "vproduct5max" }
            ]
          }
        },
        {
          "id": "blkproductscheck",
          "type": "Condition",
          "items": [
            {
              "id": "itmproductsnone",
              "outgoingEdgeId": "edgeproductserror",
              "content": { "comparisons": [{ "id": "cmpproduct1empty", "variableId": "vproduct1id", "comparisonOperator": "Equal to", "value": "" }] }
            }
          ],
          "outgoingEdgeId": "edgeproductsmenu"
        }
      ]
    },
    {
      "id": "grpproductmenu",
      "title": "Menú de productos",
      "graphCoordinates": { "x": 1820, "y": 0 },
      "blocks": [
        {
          "id": "blkproductmenutext",
          "type": "text",
          "content": { "richText": [{ "id": "rtproductmenu", "type": "p", "children": [{ "text": "🛍️ Servicios disponibles\n\n1. {{product1Name}}\n2. {{product2Name}}\n3. {{product3Name}}\n4. {{product4Name}}\n5. {{product5Name}}\n\nEscribe el número del servicio:" }] }] }
        },
        {
          "id": "blkproductselectioninput",
          "type": "text input",
          "options": { "labels": { "placeholder": "1, 2, 3, 4 o 5" }, "variableId": "vproductselection" },
          "outgoingEdgeId": "edgemenuselection"
        }
      ]
    },
    {
      "id": "grpselectionrouter",
      "title": "Validar selección",
      "graphCoordinates": { "x": 2200, "y": 0 },
      "blocks": [
        {
          "id": "blkselectioncondition",
          "type": "Condition",
          "items": [
            { "id": "itmselection1", "outgoingEdgeId": "edgeselect1", "content": { "comparisons": [{ "id": "cmpselection1", "variableId": "vproductselection", "comparisonOperator": "Equal to", "value": "1" }] } },
            { "id": "itmselection2", "outgoingEdgeId": "edgeselect2", "content": { "comparisons": [{ "id": "cmpselection2", "variableId": "vproductselection", "comparisonOperator": "Equal to", "value": "2" }] } },
            { "id": "itmselection3", "outgoingEdgeId": "edgeselect3", "content": { "comparisons": [{ "id": "cmpselection3", "variableId": "vproductselection", "comparisonOperator": "Equal to", "value": "3" }] } },
            { "id": "itmselection4", "outgoingEdgeId": "edgeselect4", "content": { "comparisons": [{ "id": "cmpselection4", "variableId": "vproductselection", "comparisonOperator": "Equal to", "value": "4" }] } },
            { "id": "itmselection5", "outgoingEdgeId": "edgeselect5", "content": { "comparisons": [{ "id": "cmpselection5", "variableId": "vproductselection", "comparisonOperator": "Equal to", "value": "5" }] } }
          ],
          "outgoingEdgeId": "edgeselectioninvalid"
        }
      ]
    },
    {
      "id": "grpselectproduct1",
      "title": "Seleccionar producto 1",
      "graphCoordinates": { "x": 2580, "y": -400 },
      "blocks": [
        { "id": "blkselect1id", "type": "Set variable", "options": { "variableId": "vselectedproductid", "expressionToEvaluate": "{{product1Id}}" } },
        { "id": "blkselect1name", "type": "Set variable", "options": { "variableId": "vselectedproductname", "expressionToEvaluate": "{{product1Name}}" }, "outgoingEdgeId": "edgeselect1check" }
      ]
    },
    {
      "id": "grpselectproduct2",
      "title": "Seleccionar producto 2",
      "graphCoordinates": { "x": 2580, "y": -200 },
      "blocks": [
        { "id": "blkselect2id", "type": "Set variable", "options": { "variableId": "vselectedproductid", "expressionToEvaluate": "{{product2Id}}" } },
        { "id": "blkselect2name", "type": "Set variable", "options": { "variableId": "vselectedproductname", "expressionToEvaluate": "{{product2Name}}" }, "outgoingEdgeId": "edgeselect2check" }
      ]
    },
    {
      "id": "grpselectproduct3",
      "title": "Seleccionar producto 3",
      "graphCoordinates": { "x": 2580, "y": 0 },
      "blocks": [
        { "id": "blkselect3id", "type": "Set variable", "options": { "variableId": "vselectedproductid", "expressionToEvaluate": "{{product3Id}}" } },
        { "id": "blkselect3name", "type": "Set variable", "options": { "variableId": "vselectedproductname", "expressionToEvaluate": "{{product3Name}}" }, "outgoingEdgeId": "edgeselect3check" }
      ]
    },
    {
      "id": "grpselectproduct4",
      "title": "Seleccionar producto 4",
      "graphCoordinates": { "x": 2580, "y": 200 },
      "blocks": [
        { "id": "blkselect4id", "type": "Set variable", "options": { "variableId": "vselectedproductid", "expressionToEvaluate": "{{product4Id}}" } },
        { "id": "blkselect4name", "type": "Set variable", "options": { "variableId": "vselectedproductname", "expressionToEvaluate": "{{product4Name}}" }, "outgoingEdgeId": "edgeselect4check" }
      ]
    },
    {
      "id": "grpselectproduct5",
      "title": "Seleccionar producto 5",
      "graphCoordinates": { "x": 2580, "y": 400 },
      "blocks": [
        { "id": "blkselect5id", "type": "Set variable", "options": { "variableId": "vselectedproductid", "expressionToEvaluate": "{{product5Id}}" } },
        { "id": "blkselect5name", "type": "Set variable", "options": { "variableId": "vselectedproductname", "expressionToEvaluate": "{{product5Name}}" }, "outgoingEdgeId": "edgeselect5check" }
      ]
    },
    {
      "id": "grpselectedcheck",
      "title": "Producto disponible",
      "graphCoordinates": { "x": 2960, "y": 0 },
      "blocks": [
        {
          "id": "blkselectedcondition",
          "type": "Condition",
          "items": [
            {
              "id": "itmselectedempty",
              "outgoingEdgeId": "edgeselectedunavailable",
              "content": { "comparisons": [{ "id": "cmpselectedempty", "variableId": "vselectedproductid", "comparisonOperator": "Equal to", "value": "" }] }
            }
          ],
          "outgoingEdgeId": "edgeselectedquantity"
        }
      ]
    },
    {
      "id": "grpproductunavailable",
      "title": "Slot no disponible",
      "graphCoordinates": { "x": 3340, "y": -180 },
      "blocks": [
        {
          "id": "blkunavailabletext",
          "type": "text",
          "content": { "richText": [{ "id": "rtunavailable", "type": "p", "children": [{ "text": "Ese servicio no está disponible." }] }] },
          "outgoingEdgeId": "edgeunavailablemenu"
        }
      ]
    },
    {
      "id": "grpinvalidselection",
      "title": "Selección inválida",
      "graphCoordinates": { "x": 2580, "y": 620 },
      "blocks": [
        {
          "id": "blkinvalidselectiontext",
          "type": "text",
          "content": { "richText": [{ "id": "rtinvalidselection", "type": "p", "children": [{ "text": "La opción no es válida. Escribe un número del 1 al 5." }] }] },
          "outgoingEdgeId": "edgeinvalidselectionmenu"
        }
      ]
    },
    {
      "id": "grpquantity",
      "title": "Cantidad",
      "graphCoordinates": { "x": 3340, "y": 80 },
      "blocks": [
        {
          "id": "blkquantityquestion",
          "type": "text",
          "content": { "richText": [{ "id": "rtquantityquestion", "type": "p", "children": [{ "text": "¿Qué cantidad necesitas?" }] }] }
        },
        {
          "id": "blkquantityinput",
          "type": "text input",
          "options": { "labels": { "placeholder": "Escribe un número entero" }, "variableId": "vquantityinput" }
        },
        {
          "id": "blkquantityconvert",
          "type": "Set variable",
          "options": {
            "variableId": "vquantity",
            "expressionToEvaluate": "Number.isInteger(Number(\"{{quantityInput}}\")) && Number(\"{{quantityInput}}\") > 0 ? Number(\"{{quantityInput}}\") : \"\""
          }
        },
        {
          "id": "blkquantitycondition",
          "type": "Condition",
          "items": [
            {
              "id": "itmquantityinvalid",
              "outgoingEdgeId": "edgequantityinvalid",
              "content": { "comparisons": [{ "id": "cmpquantityempty", "variableId": "vquantity", "comparisonOperator": "Equal to", "value": "" }] }
            }
          ],
          "outgoingEdgeId": "edgequantityquote"
        }
      ]
    },
    {
      "id": "grpinvalidquantity",
      "title": "Cantidad inválida",
      "graphCoordinates": { "x": 3720, "y": -100 },
      "blocks": [
        {
          "id": "blkinvalidquantitytext",
          "type": "text",
          "content": { "richText": [{ "id": "rtinvalidquantity", "type": "p", "children": [{ "text": "Ingresa una cantidad entera mayor que cero." }] }] },
          "outgoingEdgeId": "edgeinvalidquantityretry"
        }
      ]
    },
    {
      "id": "grpcreatequote",
      "title": "Crear Quote",
      "graphCoordinates": { "x": 3720, "y": 160 },
      "blocks": [
        { "id": "blkclearquoteid", "type": "Set variable", "options": { "variableId": "vquoteid", "expressionToEvaluate": "" } },
        {
          "id": "blkquotewebhook",
          "type": "Webhook",
          "options": {
            "webhook": {
              "url": "{{backend_base_url}}/bot/v1/quotes",
              "method": "POST",
              "headers": [
                { "id": "hdrauthquote", "key": "Authorization", "value": "Bearer {{backend_token}}" },
                { "id": "hdrctquote", "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"productId\": \"{{selectedProductId}}\",\n  \"quantity\": {{quantity}},\n  \"currency\": \"CLP\",\n  \"customerId\": \"{{customerId}}\"\n}"
            },
            "isCustomBody": true,
            "responseVariableMapping": [
              { "id": "mapquoteid", "bodyPath": "data.quoteId", "variableId": "vquoteid" },
              { "id": "mapquoteproductname", "bodyPath": "data.productName", "variableId": "vquoteproductname" },
              { "id": "mapquotequantity", "bodyPath": "data.quantity", "variableId": "vquotequantity" },
              { "id": "mapquotecurrency", "bodyPath": "data.currency", "variableId": "vquotecurrency" },
              { "id": "mapquotetotal", "bodyPath": "data.totalPrice", "variableId": "vquotetotal" },
              { "id": "mapquotestatus", "bodyPath": "data.status", "variableId": "vquotestatus" }
            ]
          }
        },
        {
          "id": "blkquotecheck",
          "type": "Condition",
          "items": [
            {
              "id": "itmquotemissing",
              "outgoingEdgeId": "edgequoteerror",
              "content": { "comparisons": [{ "id": "cmpquoteempty", "variableId": "vquoteid", "comparisonOperator": "Equal to", "value": "" }] }
            }
          ],
          "outgoingEdgeId": "edgequotesummary"
        }
      ]
    },
    {
      "id": "grpquotesummary",
      "title": "Resumen y confirmación",
      "graphCoordinates": { "x": 4100, "y": 160 },
      "blocks": [
        {
          "id": "blkquotesummarytext",
          "type": "text",
          "content": { "richText": [{ "id": "rtquotesummary", "type": "p", "children": [{ "text": "🧾 Resumen\n\nServicio: {{quoteProductName}}\nCantidad: {{quoteQuantity}}\nTotal: ${{quoteTotal}} {{quoteCurrency}}" }] }] }
        },
        {
          "id": "blkquoteconfirmation",
          "type": "choice input",
          "items": [
            { "id": "itmconfirmorder", "content": "✅ Confirmar pedido", "outgoingEdgeId": "edgeconfirmorder" },
            { "id": "itmchooseagain", "content": "🔄 Elegir otro servicio", "outgoingEdgeId": "edgechooseagain" }
          ]
        }
      ]
    },
    {
      "id": "grpcreateorder",
      "title": "Crear Order",
      "graphCoordinates": { "x": 4480, "y": 80 },
      "blocks": [
        { "id": "blkclearorderid", "type": "Set variable", "options": { "variableId": "vorderid", "expressionToEvaluate": "" } },
        {
          "id": "blkorderwebhook",
          "type": "Webhook",
          "options": {
            "webhook": {
              "url": "{{backend_base_url}}/bot/v1/orders",
              "method": "POST",
              "headers": [
                { "id": "hdrauthorder", "key": "Authorization", "value": "Bearer {{backend_token}}" },
                { "id": "hdrctorder", "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"quoteId\": \"{{quoteId}}\",\n  \"customerId\": \"{{customerId}}\"\n}"
            },
            "isCustomBody": true,
            "responseVariableMapping": [
              { "id": "maporderid", "bodyPath": "data.orderId", "variableId": "vorderid" },
              { "id": "maporderstatus", "bodyPath": "data.status", "variableId": "vorderstatus" },
              { "id": "maporderitemid", "bodyPath": "data.items.0.orderItemId", "variableId": "vorderitemid" },
              { "id": "mapordertotal", "bodyPath": "data.total", "variableId": "vordertotal" }
            ]
          }
        },
        {
          "id": "blkordercheck",
          "type": "Condition",
          "items": [
            {
              "id": "itmordermissing",
              "outgoingEdgeId": "edgeordererror",
              "content": { "comparisons": [{ "id": "cmporderempty", "variableId": "vorderid", "comparisonOperator": "Equal to", "value": "" }] }
            }
          ],
          "outgoingEdgeId": "edgeorderpayment"
        }
      ]
    },
    {
      "id": "grpcreatepayment",
      "title": "Crear Payment Mercado Pago",
      "graphCoordinates": { "x": 4860, "y": 80 },
      "blocks": [
        {
          "id": "blksetpaymentidempotency",
          "type": "Set variable",
          "options": { "variableId": "vpaymentidempotencykey", "expressionToEvaluate": "typebot-{{orderId}}-mercado-pago-v1" }
        },
        { "id": "blkclearpaymentid", "type": "Set variable", "options": { "variableId": "vpaymentid", "expressionToEvaluate": "" } },
        { "id": "blkclearpaymentstatus", "type": "Set variable", "options": { "variableId": "vpaymentstatus", "expressionToEvaluate": "" } },
        { "id": "blkclearcheckouturl", "type": "Set variable", "options": { "variableId": "vcheckouturl", "expressionToEvaluate": "" } },
        { "id": "blkclearpaymentexpires", "type": "Set variable", "options": { "variableId": "vpaymentexpiresat", "expressionToEvaluate": "" } },
        {
          "id": "blkpaymentwebhook",
          "type": "Webhook",
          "options": {
            "webhook": {
              "url": "{{backend_base_url}}/bot/v1/orders/{{orderId}}/payments",
              "method": "POST",
              "headers": [
                { "id": "hdrauthpayment", "key": "Authorization", "value": "Bearer {{backend_token}}" },
                { "id": "hdrctpayment", "key": "Content-Type", "value": "application/json" },
                { "id": "hdridempotencypayment", "key": "Idempotency-Key", "value": "{{paymentIdempotencyKey}}" }
              ],
              "body": "{\n  \"providerKey\": \"mercado_pago\"\n}"
            },
            "isCustomBody": true,
            "responseVariableMapping": [
              { "id": "mappaymentid", "bodyPath": "data.paymentId", "variableId": "vpaymentid" },
              { "id": "mappaymentstatus", "bodyPath": "data.status", "variableId": "vpaymentstatus" },
              { "id": "mapcheckouturl", "bodyPath": "data.checkoutUrl", "variableId": "vcheckouturl" },
              { "id": "mappaymentexpires", "bodyPath": "data.expiresAt", "variableId": "vpaymentexpiresat" }
            ]
          }
        },
        {
          "id": "blkpaymentcheck",
          "type": "Condition",
          "items": [
            {
              "id": "itmpaymentmissing",
              "outgoingEdgeId": "edgepaymenterror",
              "content": { "comparisons": [{ "id": "cmppaymentempty", "variableId": "vpaymentid", "comparisonOperator": "Equal to", "value": "" }] }
            }
          ],
          "outgoingEdgeId": "edgepaymentstatus"
        }
      ]
    },
    {
      "id": "grppaymentstatus",
      "title": "Estado del Payment",
      "graphCoordinates": { "x": 5620, "y": 80 },
      "blocks": [
        {
          "id": "blkpaymentstatuscondition",
          "type": "Condition",
          "items": [
