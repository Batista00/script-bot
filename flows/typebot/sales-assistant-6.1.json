              "outgoingEdgeId": "orderedge",
              "content": {
                "comparisons": [
                  {
                    "id": "ordercomparison",
                    "variableId": "vaction",
                    "comparisonOperator": "Equal to",
                    "value": "crear_pedido"
                  }
                ]
              }
            },
            {
              "id": "paymentitem",
              "outgoingEdgeId": "paymentedge",
              "content": {
                "comparisons": [
                  {
                    "id": "paymentcomparison",
                    "variableId": "vaction",
                    "comparisonOperator": "Equal to",
                    "value": "elegir_pago"
                  }
                ]
              }
            },
            {
              "id": "statusitem",
              "outgoingEdgeId": "statusedge",
              "content": {
                "comparisons": [
                  {
                    "id": "statuscomparison",
                    "variableId": "vaction",
                    "comparisonOperator": "Equal to",
                    "value": "consultar_pedido"
                  }
                ]
              }
            },
            {
              "id": "humanitem",
              "outgoingEdgeId": "humanedge",
              "content": {
                "comparisons": [
                  {
                    "id": "humancomparison",
                    "variableId": "vaction",
                    "comparisonOperator": "Equal to",
                    "value": "derivar_humano"
                  }
                ]
              }
            }
