              "outgoingEdgeId": "destinationedge",
              "content": {
                "comparisons": [
                  {
                    "id": "destinationcomparison",
                    "variableId": "vaction",
                    "comparisonOperator": "Equal to",
                    "value": "capturar_destino"
                  }
