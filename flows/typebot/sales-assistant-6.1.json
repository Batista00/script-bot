      "isSessionVariable": true
    },
    {
      "id": "vaiquestion",
      "name": "ai_question",
      "isSessionVariable": true
    },
    {
      "id": "vaireply",
      "name": "ai_reply",
      "isSessionVariable": true
    },
    {
      "id": "vopenairesponseid",
      "name": "openai_response_id",
      "isSessionVariable": true
    }
  ],
