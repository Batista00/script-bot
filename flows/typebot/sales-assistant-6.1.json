{
  "version": "6.1",
  "id": "bwtypesales61",
  "name": "BW — Agente comercial WhatsApp 6.1",
  "events": [
    {
      "id": "start",
      "type": "start",
      "graphCoordinates": {
        "x": 0,
        "y": 0
      },
      "outgoingEdgeId": "startedge"
