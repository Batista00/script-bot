            "expressionToEvaluate": "String(JSON.parse(decodeURIComponent({{incoming_payload}})).text||\"\")"
          }
        },
        {
          "id": "readremote",
          "type": "Set variable",
          "options": {
            "variableId": "vremoteJid",
            "expressionToEvaluate": "String(JSON.parse(decodeURIComponent({{incoming_payload}})).remoteJid||\"\")"
          }
        },
        {
          "id": "readname",
          "type": "Set variable",
          "options": {
            "variableId": "vpushName",
            "expressionToEvaluate": "String(JSON.parse(decodeURIComponent({{incoming_payload}})).pushName||\"\")"
          }
        },
        {
          "id": "readinbox",
          "type": "Set variable",
          "options": {
            "variableId": "vinboxid",
            "expressionToEvaluate": "String(JSON.parse(decodeURIComponent({{incoming_payload}})).inboxId||\"\")"
          }
        },
        {
          "id": "readlease",
          "type": "Set variable",
          "options": {
            "variableId": "vinboxlease",
            "expressionToEvaluate": "String(JSON.parse(decodeURIComponent({{incoming_payload}})).inboxLease||\"\")"
          }
        },
        {
          "id": "clearincoming",
          "type": "Set variable",
          "options": {
            "variableId": "vincomingpayload",
            "expressionToEvaluate": "\"\""
          }
        },
        {
          "id": "resetready",
          "type": "Set variable",
          "options": {
            "variableId": "vbackendready",
            "expressionToEvaluate": "no"
          }
        },
        {
          "id": "resetreply",
          "type": "Set variable",
          "options": {
            "variableId": "vreplyallowed",
            "expressionToEvaluate": "yes"
          }
        },
        {
          "id": "resetanswer",
          "type": "Set variable",
          "options": {
            "variableId": "vassistantmessage",
            "expressionToEvaluate": "\"\""
          }
        },
        {
          "id": "resetaction",
          "type": "Set variable",
          "options": {
            "variableId": "vaction",
            "expressionToEvaluate": "continuar"
          }
        },
        {
          "id": "resetdecision",
          "type": "Set variable",
          "options": {
            "variableId": "vdecisionpayload",
            "expressionToEvaluate": "none"
          }
        },
        {
          "id": "resetcompleted",
          "type": "Set variable",
          "options": {
            "variableId": "vactioncompleted",
            "expressionToEvaluate": "no"
          }
        },
        {
          "id": "resetcount",
          "type": "Set variable",
          "options": {
            "variableId": "vactioncount",
            "expressionToEvaluate": "0"
