    {
      "id": "is-whatsapp",
      "name": "Is WhatsApp",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Is WhatsApp-condition",
              "leftValue": "={{ $json.channel === 'whatsapp' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "expand-whatsapp-bubbles",
      "name": "Expand WhatsApp bubbles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "jsCode": "function decodeOutboxMessages(value){\n  const outboxPrefix=\"__BW_MESSAGES_V1__\";\n  const text=String(value??\"\");\n  if(!text.startsWith(outboxPrefix))return text.trim() ? [text.trim()] : [];\n  try {\n    const messages=JSON.parse(text.slice(outboxPrefix.length));\n    if(!Array.isArray(messages))throw new Error(\"OUTBOX_MESSAGES_INVALID\");\n    return messages.map(item=>String(item).trim()).filter(Boolean).slice(0,3);\n  } catch {\n    throw new Error(\"OUTBOX_MESSAGES_INVALID\");\n  }\n}\nconst notification=$json;\nconst messages=decodeOutboxMessages(notification.payload?.text);\nif(!messages.length)throw new Error('WHATSAPP_EMPTY_MESSAGE');\nreturn messages.map((text,index)=>({json:{...notification,whatsappText:text,whatsappDelay:600+index*150}}));"
      }
    },
    {
      "id": "send-whatsapp",
      "name": "Send WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2160,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.config.evolutionBaseUrl + '/message/sendText/' + encodeURIComponent($('Config').first().json.config.instance) }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {number:$json.payload.contact,text:$json.whatsappText,delay:$json.whatsappDelay} }}",
        "options": {
          "timeout": 60000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Evolution API"
        }
      }
    },
    {
      "id": "verify-whatsapp-result",
      "name": "Verify WhatsApp result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        0
      ],
      "parameters": {
        "jsCode": "const sent=$input.all();if(!sent.length||sent.some(item=>!item.json.key?.id))throw new Error('EVOLUTION_SEND_UNCONFIRMED');return [{json:{ok:true,count:sent.length}}];"
      }
    },
    {
      "id": "prepare-telegram",
      "name": "Prepare Telegram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        0
      ],
      "parameters": {
        "jsCode": "const item=$json;const escape=s=>String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;');item.telegramText=escape(item.payload.text||'');const evidence=item.payload.evidence;return [{json:item,...(evidence?{binary:{data:{data:evidence.base64,mimeType:evidence.mimeType,fileName:evidence.mimeType==='image/png'?'comprobante.png':'comprobante.jpg'}}}:{})}];"
      }
    },
    {
      "id": "has-evidence",
      "name": "Has evidence",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2880,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Has evidence-condition",
              "leftValue": "={{ Boolean($json.payload.evidence) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "send-telegram-text",
      "name": "Send Telegram text",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        3120,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.payload.chatId }}",
        "text": "={{ $json.telegramText }}",
        "replyMarkup": "none",
        "additionalFields": {
          "parse_mode": "HTML",
          "appendAttribution": false,
          "protect_content": true
        }
      },
      "credentials": {
        "telegramApi": {
          "name": "Telegram Ventas Admin"
        }
      }
    },
    {
      "id": "send-telegram-evidence",
      "name": "Send Telegram evidence",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        3360,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendPhoto",
        "chatId": "={{ $json.payload.chatId }}",
        "binaryData": true,
        "binaryPropertyName": "data",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": "={{ {rows:$json.payload.replyMarkup.inline_keyboard.map(row=>({row:{buttons:row.map(button=>({text:button.text,additionalFields:{callback_data:button.callback_data}}))}}))} }}",
        "additionalFields": {
          "caption": "={{ $json.telegramText.slice(0,1000) }}",
          "parse_mode": "HTML",
          "protect_content": true
        }
      },
      "credentials": {
        "telegramApi": {
          "name": "Telegram Ventas Admin"
        }
      }
    },
    {
