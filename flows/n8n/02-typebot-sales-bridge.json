{
  "name": "BW 02 — Typebot → backend comercial",
  "nodes": [
    {
      "id": "typebot-bridge",
      "name": "Typebot bridge",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "bw-sales-bridge",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "f1fe0605-78ee-4267-849e-3945082592c2"
    },
    {
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const config={\"backendBaseUrl\":\"https://admin.pablete.xyz/api\",\"typebotBaseUrl\":\"https://bot.pablete.xyz\",\"n8nBaseUrl\":\"https://n8n.pablete.xyz\",\"typebotPublicId\":\"CONFIGURAR_PUBLIC_ID\",\"evolutionBaseUrl\":\"https://evo.pablete.xyz\",\"instance\":\"CONFIGURAR_INSTANCIA\",\"automationIntegrationId\":\"CONFIGURAR_UUID\",\"openaiModel\":\"CONFIGURAR_MODELO\",\"evidenceAiEnabled\":false}; return $input.all().map((item,i)=>({json:{...item.json,config},pairedItem:{item:i}}));"
      }
    },
    {
      "id": "validate-sales-turn",
      "name": "Validate sales turn",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const body=$json.body&&typeof $json.body==='object'?$json.body:{};\nconst sessionToken=typeof body.sessionToken==='string'?body.sessionToken:'';\nif(!/^cs_[A-Za-z0-9_-]{43}$/.test(sessionToken))throw new Error('SALES_TURN_TOKEN_MISSING');\nif(typeof body.messageId!=='string'||!body.messageId||typeof body.text!=='string')throw new Error('SALES_TURN_CONTEXT_MISSING');\nreturn [{json:{messageId:body.messageId,text:body.text,authorization:'Bearer '+sessionToken}}];"
      }
    },
    {
      "id": "sales-message",
      "name": "Sales message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.config.backendBaseUrl + '/conversation/v1/message' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {messageId:$json.messageId,text:$json.text} }}",
        "options": {
          "timeout": 60000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true,
              "responseFormat": "json"
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $json.authorization }}"
            }
          ]
        }
      }
    },
    {
      "id": "prepare-safe-response",
      "name": "Prepare safe response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "const statusCode=Number($json.statusCode??200);\nconst candidate=$json.body&&typeof $json.body==='object'?$json.body:\n  $json.response&&typeof $json.response==='object'?$json.response:$json;\nconst successful=statusCode>=200&&statusCode<300&&candidate&&typeof candidate==='object';\nconst reply=successful?candidate:{};\nconst advice=reply.advice&&typeof reply.advice==='object'?reply.advice:null;\nconst fallback='No pude completar esa consulta en este momento. Puedo intentarlo nuevamente o derivarte con una persona.';\nconst hasText=typeof reply.text==='string'&&reply.text.trim().length>0;\nconst text=hasText?reply.text.trim():fallback;\nconst customerText=$('Validate sales turn').item.json.text;\nconst authorizedContext=[text,advice?String(advice.instructions||''):''].filter(Boolean).join('\\n\\n').slice(0,6000);\nreturn [{json:{\n  text,\n  needsAi:successful&&hasText&&reply.paused!==true?'yes':'no',\n  aiContext:successful&&hasText?authorizedContext:'',\n  aiQuestion:(advice&&typeof advice.question==='string'&&advice.question.trim()?advice.question:customerText).slice(0,2000)\n}}];"
      }
    },
    {
      "id": "reply",
      "name": "Reply",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      }
    }
  ],
  "connections": {
