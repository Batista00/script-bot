      ],
      "parameters": {
        "jsCode": "const config={\"backendBaseUrl\":\"https://admin.pablete.xyz/api\",\"typebotBaseUrl\":\"https://bot.pablete.xyz\",\"n8nBaseUrl\":\"https://n8n.pablete.xyz\",\"typebotPublicId\":\"CONFIGURAR_PUBLIC_ID\",\"evolutionBaseUrl\":\"https://evo.pablete.xyz\",\"instance\":\"CONFIGURAR_INSTANCIA\",\"automationIntegrationId\":\"CONFIGURAR_UUID\",\"telegramIntegrationId\":\"CONFIGURAR_TELEGRAM_UUID\",\"openaiModel\":\"CONFIGURAR_MODELO\",\"evidenceAiEnabled\":true}; return $input.all().map((item,i)=>({json:{...item.json,config},pairedItem:{item:i}}));"
      }
    },
    {
      "id": "normalize-incoming",
      "name": "Normalize incoming",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "function normalizeEvolution(body,expectedInstance){\n  if(!body || body.instance!==expectedInstance)throw new Error(\"EVOLUTION_INSTANCE_MISMATCH\");\n  if(![\"messages.upsert\",\"MESSAGES_UPSERT\"].includes(body.event))return null;\n  const data=body.data;const key=data?.key;\n  if(!key || key.fromMe || !key.id)return null;\n  const remote=String(key.remoteJid ?? \"\");\n  if(remote.endsWith(\"@g.us\") || remote===\"status@broadcast\")return null;\n  const jid=remote.endsWith(\"@s.whatsapp.net\") ? remote : String(key.remoteJidAlt ?? \"\");\n  if(!/^[0-9]{8,15}(?::[0-9]+)?@s\\.whatsapp\\.net$/.test(jid))throw new Error(\"PHONE_IDENTITY_UNRESOLVED\");\n  const contact=jid.split(\"@\")[0].split(\":\")[0];\n  const message=data.message ?? {};\n  const image=Boolean(message.imageMessage);\n  const text=message.conversation ?? message.extendedTextMessage?.text ?? message.imageMessage?.caption ?? \"\";\n  if(!image && !text)return null;\n  return {contact,name:String(data.pushName||contact).slice(0,120),messageId:String(key.id).slice(0,128),text:String(text).slice(0,10000),image};\n}\nconst message=normalizeEvolution($json.body,$json.config.instance);return [{json:message ?? {ignored:true}}];"
      }
    },
