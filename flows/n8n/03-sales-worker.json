        "url": "={{ $('Config').first().json.config.backendBaseUrl + '/automation/v1/' + $('Config').first().json.config.automationIntegrationId + '/inbox/claim' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 60000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        },
        "authentication": "genericCredentialType",
