              "followRedirects": false
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Open session').item.json.sessionToken }}"
            }
          ]
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "evidence-receipt",
      "name": "Evidence receipt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4800,
        0
      ],
      "parameters": {
        "jsCode": "return [{json:{text:$('Validate evidence result').item.json.text||''}}];"
      }
    }
