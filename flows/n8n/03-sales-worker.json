    {
      "id": "is-image",
      "name": "Is image",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Is image-condition",
              "leftValue": "={{ $('Each message').item.json.payload.image }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "read-evolution-media",
      "name": "Read Evolution media",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.config.evolutionBaseUrl + '/chat/getBase64FromMediaMessage/' + encodeURIComponent($('Config').first().json.config.instance) }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {message:{key:{id:$('Each message').item.json.payload.messageId,remoteJid:$('Each message').item.json.contact+'@s.whatsapp.net',fromMe:false}},convertToMp4:false} }}",
        "options": {
          "timeout": 60000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Evolution API"
        }
      }
    },
    {
      "id": "check-media-limits",
      "name": "Check media limits",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "jsCode": "const valid=typeof $json.base64==='string'&&$json.base64.length<=2800000&&['image/jpeg','image/png'].includes($json.mimetype);return [{json:valid?{...$json,valid}:{valid,error:{code:'INVALID_PAYMENT_EVIDENCE'}}}];"
      }
    },
    {
      "id": "media-usable",
      "name": "Media usable",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2160,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Media usable-condition",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "submit-private-evidence",
      "name": "Submit private evidence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2400,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.config.backendBaseUrl + '/conversation/v1/evidence' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {base64:$json.base64,mimeType:$json.mimetype} }}",
        "options": {
          "timeout": 60000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Open session').item.json.sessionToken }}"
            }
          ]
        }
      }
    },
    {
      "id": "validate-evidence-result",
      "name": "Validate evidence result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        0
      ],
      "parameters": {
        "jsCode": "function evidenceResponse(body){\n  if (body && (typeof body.reviewId===\"string\" || body.reviewId===null) && typeof body.text===\"string\") return body;\n  const messages={\n    INVALID_REQUEST:\"No pude leer ese comprobante. Envía una imagen JPG o PNG de hasta 2 MB, no un archivo PDF.\",\n    INVALID_PAYMENT_EVIDENCE:\"El comprobante no tiene un formato o tamaño válido. Envía una imagen JPG o PNG de hasta 2 MB.\",\n    PAYMENT_REQUIRED:\"Selecciona primero transferencia bancaria para tu pedido. Escribe ESTADO o HUMANO si necesitas ayuda.\",\n    SALES_CHECKOUT_REQUIRED:\"Primero selecciona un producto y crea tu pedido. Escribe CATÁLOGO.\",\n    PAYMENT_NOT_REVIEWABLE:\"Este pago no admite otro comprobante pendiente. Escribe ESTADO para consultar el pedido o HUMANO.\",\n    REVIEW_NOT_CONFIGURED:\"La revisión de transferencias todavía no está configurada. Escribe HUMANO para contactar al equipo.\",\n  };\n  const text=messages[body?.error?.code];\n  if(!text)throw new Error(\"EVIDENCE_SERVICE_UNAVAILABLE\");\n  return {reviewId:null,text};\n}\nreturn [{json:evidenceResponse($json)}];"
      }
    },
    {
      "id": "run-typebot",
      "name": "Run Typebot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.config.typebotBaseUrl + '/api/v1/typebots/' + encodeURIComponent($('Config').first().json.config.typebotPublicId) + '/startChat' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {prefilledVariables:{session_token:$('Open session').item.json.sessionToken,message_id:$('Each message').item.json.payload.messageId,customer_message:$('Each message').item.json.payload.text}}} }}",
        "options": {
          "timeout": 60000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      }
    },
    {
      "id": "read-typebot-reply",
      "name": "Read Typebot reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3120,
        0
      ],
      "parameters": {
        "jsCode": "function typebotText(response){\n  function plain(value){\n    if(Array.isArray(value))return value.map(plain).join(\"\");\n    if(!value || typeof value!==\"object\")return \"\";\n    if(typeof value.text===\"string\")return value.text;\n    const result=plain(value.children ?? value.content ?? []);\n    return value.type===\"p\" ? result+\"\\n\" : result;\n  }\n  return (response.messages ?? []).filter(m=>m.type===\"text\").map(m=>plain(m.content?.richText ?? [])).join(\"\\n\").trim();\n}\nconst text=typebotText($json);if(!Array.isArray($json.messages))throw new Error('TYPEBOT_INVALID_RESPONSE');return [{json:{text}}];"
      }
    },
    {
      "id": "finish-inbox-and-queue-reply",
      "name": "Finish inbox and queue reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
