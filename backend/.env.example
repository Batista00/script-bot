NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://bot:change-me@localhost:5432/bot_whatsapp
LOG_LEVEL=info
AUTH_SESSION_TTL_HOURS=168
INTEGRATIONS_ENCRYPTION_KEY=
PUBLIC_API_BASE_URL=

# Rate limiting del login. Se aplica solo a POST /auth/login y el contador vive
# en memoria del proceso, por lo que es válido para una sola réplica.
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Confianza de proxy para resolver la IP real del cliente. "loopback" asume el
# reverse proxy documentado en 127.0.0.1. Usar "false" si el backend se expone
# directamente, o una IP/CIDR (p. ej. 172.18.0.0/16) si el proxy está en Docker.
TRUST_PROXY=loopback

# Solo las usa el servicio PostgreSQL de docker-compose.yml.
POSTGRES_DB=bot_whatsapp
POSTGRES_USER=bot
POSTGRES_PASSWORD=change-me

# Usar solo durante `pnpm bootstrap:owner`; no guardar valores reales.
BOOTSTRAP_BUSINESS_NAME=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

# OpenAI - AI Orchestrator
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_TIMEOUT_MS=10000
