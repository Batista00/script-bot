NODE_ENV=production
PORT=3000
DATABASE_URL=
LOG_LEVEL=info
AUTH_SESSION_TTL_HOURS=168
# Clave permanente de 32 bytes base64. Respaldar cifrada fuera de la VPS y del repositorio.
INTEGRATIONS_ENCRYPTION_KEY=
# Origen previsto. La configuración DNS/TLS todavía no se aplica.
PUBLIC_API_BASE_URL=https://api.pablete.xyz

# Opcional. Sin clave, el endpoint de IA responde con un fallback seguro.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_TIMEOUT_MS=10000

POSTGRES_DB=bot_whatsapp
POSTGRES_USER=bot_whatsapp
POSTGRES_PASSWORD=

# Elegir el puerto después de inventariar la VPS. El bind loopback evita exposición pública directa.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_HOST_PORT=

# Worker de background (opcional). Consume la cola `job_queue` de PostgreSQL:
# despacho de fulfillments, sincronización con proveedores, reconciliación de
# pagos y sweeps de mantenimiento. Los valores mostrados son los defaults
# seguros del código; pueden omitirse o dejarse vacíos. No añadir secretos aquí.
WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=10
WORKER_LEASE_SECONDS=120
WORKER_RECONCILE_ORDERS_SECONDS=120
WORKER_RECONCILE_FULFILLMENTS_SECONDS=180
WORKER_RECONCILE_PAYMENTS_SECONDS=300
WORKER_PRUNE_SESSIONS_SECONDS=21600
