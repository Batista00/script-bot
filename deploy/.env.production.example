NODE_ENV=production
PORT=3000
DATABASE_URL=
LOG_LEVEL=info
AUTH_SESSION_TTL_HOURS=168
# Clave permanente de 32 bytes base64. Respaldar cifrada fuera de la VPS y del repositorio.
INTEGRATIONS_ENCRYPTION_KEY=
# Origen previsto. La configuración DNS/TLS todavía no se aplica.
PUBLIC_API_BASE_URL=https://api.pablete.xyz

POSTGRES_DB=bot_whatsapp
POSTGRES_USER=bot_whatsapp
POSTGRES_PASSWORD=

# Elegir el puerto después de inventariar la VPS. El bind loopback evita exposición pública directa.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_HOST_PORT=
